{
  "name": "michael-bday-game",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "deploy": "npm run build && firebase deploy --project michaels-web-game",
    "deploy:hosting": "npm run build && firebase deploy --only hosting --project michaels-web-game",
    "deploy:rules": "firebase deploy --only firestore:rules,storage --project michaels-web-game",
    "deploy:functions": "cd functions && npm run build && cd .. && firebase deploy --only functions --project michaels-web-game",
    "seed:seasons": "tsx scripts/seedSeasonConfigs.ts",
    "reset:may-season": "tsx scripts/resetMaySeasonAchievements.ts",
    "migrate:leaderboard": "tsx scripts/migrateLeaderboardBestScores.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@types/matter-js": "^0.20.2",
    "firebase": "^12.5.0",
    "matter-js": "^0.20.0",
    "next": "^16.2.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.1",
    "eslint": "^9",
    "eslint-config-next": "16.0.0",
    "firebase-admin": "^13.8.0",
    "firebase-tools": "15.19.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
