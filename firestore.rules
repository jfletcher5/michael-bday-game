rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Leaderboard: read-only for clients
    // Writes are only allowed via Cloud Functions (Admin SDK bypasses rules)
    match /leaderboard/{entry} {
      allow read: if true;
      allow write: if false;
    }
    
    // Game sessions: no direct client access
    match /gameSessions/{session} {
      allow read, write: if false;
    }

    match /seasonConfigs/{seasonId} {
      allow read: if true;
      allow write: if false;
    }

    match /proPassConfigs/{passId} {
      allow read: if true;
      allow write: if false;
    }
    
    // User-created levels — public reads only; writes via Cloud Functions (MIE-19).
    match /levels/{levelId} {
      allow read: if resource.data.visibility == 'public'
        && (resource.data.archived == false || !('archived' in resource.data));
      allow write: if false;
    }
    
    match /users/{username} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if true;
    }

    match /messages/{messageId} {
      allow read: if true;
      allow write: if true;
    }

    match /shopOffers/{offerId} {
      allow read: if true;
      allow write: if true;
    }

    match /polls/{pollId} {
      allow read: if true;
      allow write: if true;

      match /answers/{username} {
        allow read: if true;
        allow write: if true;
      }
    }

    match /avatarItems/{itemId} {
      allow read: if true;
      allow write: if true;
    }

    // Avatar Item Studio drafts — owner read/write enforced via Cloud Functions (MIE-37).
    match /avatarStudioProjects/{projectId} {
      allow read: if false;
      allow write: if false;
    }

    // Shop gift audit log — clients write via giftShopItem transaction (MIE-21).
    match /giftTransactions/{giftId} {
      allow read: if true;
      allow write: if true;
    }

    // Friends & social (MIE-20)
    match /friendRequests/{requestId} {
      allow read, write: if true;
    }

    match /friendships/{pairId} {
      allow read, write: if true;
    }

    match /raceChallenges/{challengeId} {
      allow read, write: if true;
    }

    match /chats/{pairId}/messages/{messageId} {
      allow read, write: if true;
    }
  }
}
